# Salin ke .env: cp .env.example .env

# --- LLM ---
# mock      = jawaban dari data sintetis (tanpa API key), untuk tes dan demo
# deepseek  = API DeepSeek; isi LLM_API_KEY. LLM_BASE_URL/LLM_MODEL boleh kosong
#             (bawaan https://api.deepseek.com dan deepseek-chat)
# openai_compatible = server lain yang kompatibel OpenAI; isi LLM_BASE_URL dan LLM_MODEL
# Jangan pernah commit API key. Cek ulang lokasi pemrosesan data sebelum memakai data nyata.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- OCR (halaman pindaian) ---
# paddle = PaddleOCR (terpasang di image worker), none = lewati halaman pindaian
OCR_ENGINE=paddle
OCR_LANG=latin

# --- PostgreSQL ---
POSTGRES_USER=mab
POSTGRES_PASSWORD=mab_dev_password
POSTGRES_DB=mab
DATABASE_URL=postgresql+psycopg://mab:mab_dev_password@postgres:5432/mab

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=claims

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=mabminio
MINIO_ROOT_PASSWORD=mabminio_dev_password
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mab-documents
# U8: enkripsi at rest. MinIO memakai kunci KMS bawaan di bawah (khusus dev, jangan dipakai di cloud).
# S3_SSE: AES256 (SSE-S3) atau aws:kms (SSE-KMS + S3_KMS_KEY_ID). Kosong = tanpa enkripsi.
MINIO_KMS_SECRET_KEY=mab-dev-key:Zm9yLWRldi1vbmx5LWRvLW5vdC11c2UtaW4tY2xvdWQ=
S3_SSE=AES256
S3_KMS_KEY_ID=
S3_REGION=us-east-1
# U8: backup (docker compose run --rm ops backup)
BACKUP_BUCKET=mab-backups
BACKUP_RETENTION_DAYS=30

# --- API ---
JWT_SECRET=ganti_dengan_rahasia_acak_minimal_32_karakter
RULES_PATH=/app/rules/aturan_klinis_demo.yaml

# --- Web ---
# Portal memanggil API lewat proxy /api di server web (lihat docker-compose: API_INTERNAL_URL).
# Untuk `npm run dev` di luar Docker, default-nya http://localhost:8000.
API_INTERNAL_URL=http://localhost:8000

# --- Demo ---
# true = tampilkan pemilih "Ganti peran (demo)" untuk akun demo. Hanya untuk data rekaan.
DEMO_MODE=true

# --- U2: integrasi & benefit ---
# Kosong = rules/aturan_benefit_demo.yaml (folder yang sama dengan RULES_PATH)
BENEFIT_RULES_PATH=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=3

# --- U3: fraud analytics ---
# Kosong = rules/aturan_fraud_demo.yaml (folder yang sama dengan RULES_PATH)
FRAUD_RULES_PATH=

# --- U8: operasi dan kesiapan data sungguhan ---
# development | staging | production. Selain development, API dan worker menolak start bila
# konfigurasi belum aman (rahasia bawaan, log bukan JSON, dsb.). Lihat docs/u8-infrastruktur-cloud.md.
ENVIRONMENT=development
LOG_FORMAT=text
LOG_LEVEL=INFO
# Antrean per jenis pekerjaan; worker mendengarkan semuanya kecuali RQ_QUEUES diisi.
RQ_QUEUE_UNDERWRITING=underwriting
RQ_QUEUE_WEBHOOKS=webhooks
# Token untuk /metrics (kosong = terbuka; di Kubernetes dibatasi NetworkPolicy)
METRICS_TOKEN=
# Batas login/PIN salah per akun sebelum dikunci sementara
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_SECONDS=900
AUTH_IP_MAX_FAILURES=100
# Gerbang data sungguhan. Biarkan false selama memakai data rekaan.
REAL_DATA_ENABLED=false
LLM_DATA_RESIDENCY_APPROVED=false
