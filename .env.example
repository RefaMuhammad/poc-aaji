# Salin ke .env: cp .env.example .env

# --- LLM ---
# mock = jawaban tetap dari fixture (tanpa API key). Ganti untuk penyedia sungguhan.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=

# --- PostgreSQL ---
POSTGRES_USER=mab
POSTGRES_PASSWORD=mab_dev_password
POSTGRES_DB=mab
DATABASE_URL=postgresql+psycopg://mab:mab_dev_password@postgres:5432/mab

# --- Redis / RQ ---
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=claims

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=mabminio
MINIO_ROOT_PASSWORD=mabminio_dev_password
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=mab-documents

# --- API ---
JWT_SECRET=ganti_dengan_rahasia_acak
RULES_PATH=/app/rules/aturan_klinis_demo.yaml

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
